{
  "expo": {
    "name": "bearbell",
    "slug": "bearbell",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "backgroundColor": "#F2EDE1",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.doublejbs.bearbell",
      "infoPlist": {
        "UIBackgroundModes": [
          "audio"
        ],
        "NSMotionUsageDescription": "bearbell uses motion sensors to ring the bell when it detects shaking in your pocket.",
        "CFBundleAllowMixedLocalizations": true,
        "ITSAppUsesNonExemptEncryption": false,
        "CFBundleLocalizations": [
          "en",
          "ko",
          "ja"
        ]
      },
      "appleTeamId": "SUZ336H4W3"
    },
    "android": {
      "package": "com.doublejbs.bearbell",
      "adaptiveIcon": {
        "backgroundColor": "#F2EDE1",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-font",
      "./plugins/WithSceneLifecycle",
      [
        "expo-widgets",
        {
          "bundleIdentifier": "com.doublejbs.bearbell.widgets",
          "groupIdentifier": "group.com.doublejbs.bearbell",
          "widgets": []
        }
      ],
      [
        "expo-localization",
        {
          "supportedLocales": {
            "ios": [
              "en",
              "ko",
              "ja"
            ],
            "android": [
              "en",
              "ko",
              "ja"
            ]
          }
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F2EDE1",
          "image": "./assets/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain"
        }
      ],
      "./plugins/WithReleaseSigning"
    ],
    "locales": {
      "ko": "./languages/ko.json",
      "ja": "./languages/ja.json"
    },
    "extra": {
      "eas": {
        "build": {
          "experimental": {
            "ios": {
              "appExtensions": [
                {
                  "targetName": "ExpoWidgetsTarget",
                  "bundleIdentifier": "com.doublejbs.bearbell.widgets",
                  "entitlements": {
                    "com.apple.security.application-groups": [
                      "group.com.doublejbs.bearbell"
                    ]
                  }
                }
              ]
            }
          }
        },
        "projectId": "076dd537-1406-4645-925f-075e9d27c9c4"
      }
    },
    "owner": "doublejbs"
  }
}
